{
  "name": "x-post-save",
  "version": "0.1.0",
  "description": "Save an X (Twitter) post to json, md, toml, or yaml",
  "type": "module",
  "bin": {
    "x-post-save": "src/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "start": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build ./src/index.ts --target=bun --outfile=dist/index.mjs"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
